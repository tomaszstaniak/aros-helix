diff --git a/src/event/source/unix/aros.rs b/src/event/source/unix/aros.rs
new file mode 100644
index 0000000000000000000000000000000000000000..22b874c60f0aca79c9807a45442f2c79369c36fb
--- /dev/null
+++ b/src/event/source/unix/aros.rs
@@ -0,0 +1,262 @@
+//! Event source for AROS consoles.
+//!
+//! AROS has no select on a console and no SIGWINCH. Readiness comes from
+//! libc's poll on the one console descriptor, which waits inside the console
+//! handler (DOS WaitForChar), so an idle source costs one request per slice
+//! rather than a timer wake-up per poll.
+//!
+//! Size changes come in-band: the source turns on resize reports (private
+//! mode 2048), which Limpet answers at once and after every change with
+//! `CSI 48 ; rows ; columns ; height ; width t`. Until a first report has
+//! arrived, the size is also read with TIOCGWINSZ once per slice, so
+//! terminals without the mode still report resizes, only later.
+use std::{
+    collections::VecDeque,
+    io,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    time::{Duration, Instant},
+};
+
+#[cfg(feature = "event-stream")]
+use crate::event::sys::Waker;
+use crate::event::{
+    source::EventSource, sys::unix::parse::parse_event, timeout::PollTimeout, Event,
+    InternalEvent,
+};
+use crate::terminal::sys::file_descriptor::{tty_fd, FileDesc};
+
+/// The longest wait inside one request. It bounds how late a wake-up from
+/// another thread is noticed and, without resize reports, a size change.
+const SLICE: Duration = Duration::from_millis(250);
+/// How long a lone ESC waits for the rest of a sequence. Limpet sends a
+/// key's sequence in one write; the margin is for slow emulated machines.
+const ESCAPE_WINDOW: Duration = Duration::from_millis(30);
+/// Bracketed paste arrives as one sequence; this bounds a runaway one.
+const MAX_SEQUENCE: usize = 4 * 1024 * 1024;
+const ENABLE_RESIZE_REPORTS: &[u8] = b"\x1b[?2048h";
+
+#[derive(Default)]
+struct Parser {
+    bytes: Vec<u8>,
+    events: VecDeque<InternalEvent>,
+    resize_reports: bool,
+}
+
+impl Parser {
+    fn feed(&mut self, bytes: &[u8]) -> io::Result<()> {
+        for &byte in bytes {
+            if self.bytes.len() == MAX_SEQUENCE {
+                self.bytes.clear();
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "terminal input sequence too long",
+                ));
+            }
+            self.bytes.push(byte);
+            if let Some(size) = resize_report(&self.bytes) {
+                self.resize_reports = true;
+                self.events
+                    .push_back(InternalEvent::Event(Event::Resize(size.0, size.1)));
+                self.bytes.clear();
+                continue;
+            }
+            // `true`: more may follow, so a lone ESC stays pending.
+            match parse_event(&self.bytes, true) {
+                Ok(Some(event)) => {
+                    self.events.push_back(event);
+                    self.bytes.clear();
+                }
+                Ok(None) => {}
+                Err(_) => self.bytes.clear(),
+            }
+        }
+        Ok(())
+    }
+
+    fn escape_pending(&self) -> bool {
+        self.bytes == [0x1b]
+    }
+
+    fn expire_escape(&mut self) {
+        if self.escape_pending() {
+            if let Ok(Some(event)) = parse_event(&self.bytes, false) {
+                self.events.push_back(event);
+            }
+            self.bytes.clear();
+        }
+    }
+}
+
+/// `CSI 48 ; rows ; columns ; height ; width t` as (columns, rows).
+fn resize_report(bytes: &[u8]) -> Option<(u16, u16)> {
+    let body = bytes.strip_prefix(b"\x1b[48;")?.strip_suffix(b"t")?;
+    let mut fields = body.split(|&b| b == b';');
+    let mut number = || -> Option<u16> {
+        let field = fields.next()?;
+        if field.is_empty() || !field.iter().all(u8::is_ascii_digit) {
+            return None;
+        }
+        std::str::from_utf8(field).ok()?.parse().ok()
+    };
+    let rows = number()?;
+    let columns = number()?;
+    // The pixel size is not part of crossterm's resize event.
+    number()?;
+    number()?;
+    if fields.next().is_some() || rows == 0 || columns == 0 {
+        return None;
+    }
+    Some((columns, rows))
+}
+
+fn geometry(_fd: libc::c_int) -> io::Result<(u16, u16)> {
+    crate::terminal::sys::window_size().map(|size| (size.columns, size.rows))
+}
+
+/// Waits up to `timeout` for input on `fd`.
+fn readable(fd: libc::c_int, timeout: Duration) -> io::Result<bool> {
+    let mut poll = libc::pollfd {
+        fd,
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    let millis = timeout.as_millis().min(i32::MAX as u128) as libc::c_int;
+    match unsafe { libc::poll(&mut poll, 1, millis) } {
+        n if n < 0 => Err(io::Error::last_os_error()),
+        0 => Ok(false),
+        _ if poll.revents & (libc::POLLERR | libc::POLLNVAL) != 0 => Err(io::Error::new(
+            io::ErrorKind::BrokenPipe,
+            "terminal input is no longer available",
+        )),
+        _ => Ok(poll.revents & libc::POLLIN != 0),
+    }
+}
+
+pub(crate) struct UnixInternalEventSource {
+    fd: FileDesc<'static>,
+    parser: Parser,
+    size: (u16, u16),
+    size_known: bool,
+    escape_since: Option<Instant>,
+    woken: Arc<AtomicBool>,
+    #[cfg(feature = "event-stream")]
+    waker: Waker,
+}
+
+impl UnixInternalEventSource {
+    pub fn new() -> io::Result<Self> {
+        let source = Self::from_file_descriptor(tty_fd()?)?;
+        // A terminal that does not know the mode ignores it; the size is
+        // then polled. The reports end when the console leaves raw mode.
+        let written = unsafe {
+            libc::write(
+                libc::STDOUT_FILENO,
+                ENABLE_RESIZE_REPORTS.as_ptr().cast(),
+                ENABLE_RESIZE_REPORTS.len(),
+            )
+        };
+        if written < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(source)
+    }
+
+    pub(crate) fn from_file_descriptor(fd: FileDesc<'static>) -> io::Result<Self> {
+        let size = geometry(fd.raw_fd());
+        let size_known = size.is_ok();
+        let size = size.unwrap_or((0, 0));
+        let woken = Arc::new(AtomicBool::new(false));
+        Ok(Self {
+            fd,
+            parser: Parser::default(),
+            size,
+            size_known,
+            escape_since: None,
+            #[cfg(feature = "event-stream")]
+            waker: Waker::new(woken.clone()),
+            woken,
+        })
+    }
+
+    fn read_input(&mut self) -> io::Result<()> {
+        let mut buffer = [0u8; 4096];
+        let n = self.fd.read(&mut buffer)?;
+        if n == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "terminal input closed",
+            ));
+        }
+        self.parser.feed(&buffer[..n])?;
+        self.escape_since = self.parser.escape_pending().then(Instant::now);
+        Ok(())
+    }
+
+    fn poll_geometry(&mut self) {
+        if self.parser.resize_reports || !self.size_known {
+            return;
+        }
+        // A console that cannot report its size cannot report a change.
+        let Ok(size) = geometry(self.fd.raw_fd()) else {
+            self.size_known = false;
+            return;
+        };
+        if size != self.size && size.0 > 0 && size.1 > 0 {
+            self.size = size;
+            self.parser
+                .events
+                .push_back(InternalEvent::Event(Event::Resize(size.0, size.1)));
+        }
+    }
+}
+
+impl EventSource for UnixInternalEventSource {
+    fn try_read(&mut self, timeout: Option<Duration>) -> io::Result<Option<InternalEvent>> {
+        let deadline = PollTimeout::new(timeout);
+        loop {
+            if let Some(event) = self.parser.events.pop_front() {
+                if let InternalEvent::Event(Event::Resize(columns, rows)) = event {
+                    self.size = (columns, rows);
+                }
+                return Ok(Some(event));
+            }
+            if self.woken.swap(false, Ordering::SeqCst) {
+                return Err(io::Error::new(
+                    io::ErrorKind::Interrupted,
+                    "Poll operation was woken up by `Waker::wake`",
+                ));
+            }
+            let mut wait = SLICE;
+            if let Some(since) = self.escape_since {
+                wait = wait.min(ESCAPE_WINDOW.saturating_sub(since.elapsed()));
+            }
+            if let Some(left) = deadline.leftover() {
+                wait = wait.min(left);
+            }
+            if readable(self.fd.raw_fd(), wait)? {
+                self.read_input()?;
+            } else {
+                if self.escape_since.is_some_and(|since| since.elapsed() >= ESCAPE_WINDOW) {
+                    self.parser.expire_escape();
+                    self.escape_since = None;
+                }
+                self.poll_geometry();
+            }
+            if self.parser.events.is_empty() && deadline.elapsed() {
+                return Ok(None);
+            }
+        }
+    }
+
+    #[cfg(feature = "event-stream")]
+    fn waker(&self) -> Waker {
+        self.waker.clone()
+    }
+}
+
+#[cfg(all(test, not(target_os = "aros")))]
+#[path = "aros_tests.rs"]
+mod tests;
