diff --git a/src/event/sys/unix/waker/aros.rs b/src/event/sys/unix/waker/aros.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a25fad10291615020478f38e0cb88b463c7082d6
--- /dev/null
+++ b/src/event/sys/unix/waker/aros.rs
@@ -0,0 +1,28 @@
+use std::{
+    io,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+};
+
+/// Allows to wake up the EventSource::try_read() method.
+///
+/// The AROS source waits in slices and checks this flag between them, so a
+/// wake-up is seen within one slice; there is no pipe to signal it sooner.
+#[derive(Clone, Debug)]
+pub(crate) struct Waker {
+    woken: Arc<AtomicBool>,
+}
+
+impl Waker {
+    pub(crate) fn new(woken: Arc<AtomicBool>) -> Self {
+        Self { woken }
+    }
+
+    /// Wake up the [`Poll`] associated with this `Waker`.
+    pub(crate) fn wake(&self) -> io::Result<()> {
+        self.woken.store(true, Ordering::SeqCst);
+        Ok(())
+    }
+}
