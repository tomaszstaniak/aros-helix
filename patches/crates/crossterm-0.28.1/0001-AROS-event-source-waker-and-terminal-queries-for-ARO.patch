+++ b/src/event/source/unix/aros_tests.rs
@@ -0,0 +1,100 @@
+use super::*;
+use crate::event::{KeyCode, KeyEvent};
+use std::os::unix::io::FromRawFd;
+
+fn pipe() -> (FileDesc<'static>, std::fs::File) {
+    let mut fds = [0; 2];
+    assert_eq!(unsafe { libc::pipe(fds.as_mut_ptr()) }, 0);
+    (FileDesc::new(fds[0], true), unsafe { std::fs::File::from_raw_fd(fds[1]) })
+}
+
+fn key(event: Option<InternalEvent>) -> KeyEvent {
+    match event {
+        Some(InternalEvent::Event(Event::Key(key))) => key,
+        other => panic!("expected a key, got {other:?}"),
+    }
+}
+
+#[test]
+fn resize_reports_are_parsed_strictly() {
+    assert_eq!(resize_report(b"\x1b[48;37;117;666;940t"), Some((117, 37)));
+    assert_eq!(resize_report(b"\x1b[48;37;117;666t"), None);
+    assert_eq!(resize_report(b"\x1b[48;37;117;666;940;1t"), None);
+    assert_eq!(resize_report(b"\x1b[48;0;117;666;940t"), None);
+    assert_eq!(resize_report(b"\x1b[48;3a;117;666;940t"), None);
+    assert_eq!(resize_report(b"\x1b[8;37;117t"), None);
+}
+
+#[test]
+fn a_report_becomes_a_resize_event_and_stops_size_polling() {
+    let mut parser = Parser::default();
+    parser.feed(b"\x1b[48;24;80;400;640tx").unwrap();
+    assert!(parser.resize_reports);
+    assert!(matches!(parser.events.pop_front(), Some(InternalEvent::Event(Event::Resize(80, 24)))));
+    assert_eq!(key(parser.events.pop_front()).code, KeyCode::Char('x'));
+}
+
+#[test]
+fn a_lone_escape_waits_and_then_expires() {
+    let mut parser = Parser::default();
+    parser.feed(b"\x1b").unwrap();
+    assert!(parser.events.is_empty() && parser.escape_pending());
+    parser.expire_escape();
+    assert_eq!(key(parser.events.pop_front()).code, KeyCode::Esc);
+}
+
+#[test]
+fn a_sequence_split_across_reads_is_one_key() {
+    let mut parser = Parser::default();
+    parser.feed(b"\x1b[").unwrap();
+    parser.feed(b"A").unwrap();
+    assert_eq!(key(parser.events.pop_front()).code, KeyCode::Up);
+    assert!(parser.events.is_empty());
+}
+
+#[test]
+fn source_reads_bytes_and_times_out() {
+    use std::io::Write;
+    let (read, mut write) = pipe();
+    let mut source = UnixInternalEventSource::from_file_descriptor(read).unwrap();
+    assert!(source.try_read(Some(Duration::from_millis(10))).unwrap().is_none());
+    write.write_all(b"ab").unwrap();
+    assert_eq!(key(source.try_read(Some(Duration::from_millis(500))).unwrap()).code, KeyCode::Char('a'));
+    assert_eq!(key(source.try_read(Some(Duration::ZERO)).unwrap()).code, KeyCode::Char('b'));
+}
+
+#[test]
+fn source_turns_a_late_lone_escape_into_esc() {
+    use std::io::Write;
+    let (read, mut write) = pipe();
+    let mut source = UnixInternalEventSource::from_file_descriptor(read).unwrap();
+    write.write_all(b"\x1b").unwrap();
+    let started = Instant::now();
+    assert_eq!(key(source.try_read(Some(Duration::from_millis(500))).unwrap()).code, KeyCode::Esc);
+    assert!(started.elapsed() >= ESCAPE_WINDOW);
+}
+
+#[test]
+fn closed_input_is_an_error_not_an_idle_loop() {
+    let (read, write) = pipe();
+    drop(write);
+    let mut source = UnixInternalEventSource::from_file_descriptor(read).unwrap();
+    let error = source.try_read(Some(Duration::from_millis(100))).unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::UnexpectedEof);
+}
+
+#[cfg(feature = "event-stream")]
+#[test]
+fn a_wake_interrupts_a_blocking_read_within_one_slice() {
+    let (read, _write) = pipe();
+    let mut source = UnixInternalEventSource::from_file_descriptor(read).unwrap();
+    let waker = source.waker();
+    let started = Instant::now();
+    std::thread::spawn(move || {
+        std::thread::sleep(Duration::from_millis(50));
+        waker.wake().unwrap();
+    });
+    let error = source.try_read(None).unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::Interrupted);
+    assert!(started.elapsed() < SLICE + Duration::from_millis(200));
+}
