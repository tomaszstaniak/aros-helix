+/// A local path as a `file:` URL.
+///
+/// On AROS an absolute path starts with a volume or assign name (`Work:notes.txt`),
+/// which `url` does not take as absolute; it becomes `file:///Work:notes.txt`,
+/// and [`file_path_from_url`] turns it back.
+#[allow(clippy::result_unit_err)]
+pub fn file_url(path: &Path) -> Result<url::Url, ()> {
+    #[cfg(target_os = "aros")]
+    if helix_stdx::path::is_absolute(path) && !path.has_root() {
+        // Concatenated, not joined: joining `Work:x` replaces the base.
+        let mut rooted = std::ffi::OsString::from("/");
+        rooted.push(path);
+        return url::Url::from_file_path(PathBuf::from(rooted));
+    }
+    url::Url::from_file_path(path)
+}
+
+/// The local path of a `file:` URL; the inverse of [`file_url`].
+#[allow(clippy::result_unit_err)]
+pub fn file_path_from_url(url: &url::Url) -> Result<PathBuf, ()> {
+    let path = url.to_file_path()?;
+    #[cfg(target_os = "aros")]
+    if let Ok(rest) = path.strip_prefix("/") {
+        if helix_stdx::path::is_absolute(rest) {
+            return Ok(rest.to_path_buf());
+        }
+    }
+    Ok(path)
+}
+
 /// A generic pointer to a file location.
