+/// Whether `path` names its location without help from the current directory.
+///
+/// On AROS a path starting with a volume or assign name (`RAM:`, `Work:Projects/notes`)
+/// or with `:` (the root of the current volume) is absolute, but std counts only a
+/// leading `/` as a root there. Everywhere else this is [`Path::is_absolute`].
+pub fn is_absolute(path: &Path) -> bool {
+    #[cfg(target_os = "aros")]
+    if let Some(Component::Normal(first)) = path.components().next() {
+        if first.as_encoded_bytes().contains(&b':') {
+            return true;
+        }
+    }
+    path.is_absolute()
+}
