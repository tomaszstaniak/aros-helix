+/// The editor's own stack on AROS. A Shell gives its commands 40 KB by
+/// default on AROS One, far too little for the editor's async state, and
+/// the process stack cannot grow; the editor runs on a thread of its own.
+#[cfg(target_os = "aros")]
+const EDITOR_STACK: usize = 16 * 1024 * 1024;
+
+#[cfg(target_os = "aros")]
+fn main() -> Result<()> {
+    let editor = std::thread::Builder::new()
+        .name("helix".into())
+        .stack_size(EDITOR_STACK)
+        .spawn(main_impl)
+        .context("could not start the editor thread")?;
+    // The runtime has shut down when main_impl returns, so its threads have
+    // ended before the process does.
+    let exit_code = match editor.join() {
+        Ok(result) => result?,
+        Err(panic) => std::panic::resume_unwind(panic),
+    };
+    std::process::exit(exit_code);
+}
