+#[cfg(target_os = "aros")]
+mod imp {
+    use super::*;
+
+    use std::os::unix::fs::PermissionsExt;
+
+    pub fn access(p: &Path, mode: AccessMode) -> io::Result<()> {
+        let metadata = std::fs::metadata(p)?;
+        let bits = metadata.permissions().mode();
+        let denied = (mode.contains(AccessMode::READ) && bits & 0o444 == 0)
+            || (mode.contains(AccessMode::WRITE) && bits & 0o222 == 0)
+            || (mode.contains(AccessMode::EXECUTE) && bits & 0o111 == 0);
+        if denied {
+            return Err(io::Error::from(io::ErrorKind::PermissionDenied));
+        }
+        Ok(())
+    }
+
+    pub fn copy_metadata(from: &Path, to: &Path) -> io::Result<()> {
+        let permissions = std::fs::metadata(from)?.permissions();
+        std::fs::set_permissions(to, permissions)
+    }
+
+    pub fn hardlink_count(p: &Path) -> std::io::Result<u64> {
+        use std::os::unix::fs::MetadataExt;
+        Ok(p.metadata()?.nlink())
+    }
+}
