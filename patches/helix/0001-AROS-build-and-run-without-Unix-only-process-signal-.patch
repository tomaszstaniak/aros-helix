diff --git a/helix-stdx/src/process.rs b/helix-stdx/src/process.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d25be832319b5ec04c2ab13611a6d7bc89821327
--- /dev/null
+++ b/helix-stdx/src/process.rs
@@ -0,0 +1,191 @@
+//! Async child processes on AROS.
+//!
+//! Tokio's `process` module needs mio, which has no AROS backend. This module
+//! offers the part of its API that Helix uses, so language servers, debug
+//! adapters, formatters, `:sh`, `:pipe` and URL openers compile unchanged;
+//! starting a program reports `Unsupported` until a thread-backed
+//! implementation replaces it. A child can therefore never exist, and the
+//! types that would belong to one are uninhabited.
+use std::{
+    ffi::OsStr,
+    fmt, io,
+    path::Path,
+    pin::Pin,
+    process::{ExitStatus, Output, Stdio},
+    task::{Context, Poll},
+};
+
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+
+fn unsupported() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::Unsupported,
+        "starting programs from Helix is not supported on AROS yet",
+    )
+}
+
+#[derive(Clone, Copy)]
+enum Never {}
+
+/// The subset of `tokio::process::Command` that Helix uses.
+#[derive(Debug)]
+pub struct Command {
+    inner: std::process::Command,
+}
+
+impl Command {
+    pub fn new<S: AsRef<OsStr>>(program: S) -> Command {
+        Command {
+            inner: std::process::Command::new(program),
+        }
+    }
+
+    pub fn arg<S: AsRef<OsStr>>(&mut self, arg: S) -> &mut Command {
+        self.inner.arg(arg);
+        self
+    }
+
+    pub fn args<I, S>(&mut self, args: I) -> &mut Command
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<OsStr>,
+    {
+        self.inner.args(args);
+        self
+    }
+
+    pub fn env<K: AsRef<OsStr>, V: AsRef<OsStr>>(&mut self, key: K, value: V) -> &mut Command {
+        self.inner.env(key, value);
+        self
+    }
+
+    pub fn envs<I, K, V>(&mut self, vars: I) -> &mut Command
+    where
+        I: IntoIterator<Item = (K, V)>,
+        K: AsRef<OsStr>,
+        V: AsRef<OsStr>,
+    {
+        self.inner.envs(vars);
+        self
+    }
+
+    pub fn current_dir<P: AsRef<Path>>(&mut self, dir: P) -> &mut Command {
+        self.inner.current_dir(dir);
+        self
+    }
+
+    pub fn stdin<T: Into<Stdio>>(&mut self, cfg: T) -> &mut Command {
+        self.inner.stdin(cfg);
+        self
+    }
+
+    pub fn stdout<T: Into<Stdio>>(&mut self, cfg: T) -> &mut Command {
+        self.inner.stdout(cfg);
+        self
+    }
+
+    pub fn stderr<T: Into<Stdio>>(&mut self, cfg: T) -> &mut Command {
+        self.inner.stderr(cfg);
+        self
+    }
+
+    pub fn kill_on_drop(&mut self, _kill_on_drop: bool) -> &mut Command {
+        self
+    }
+
+    pub fn spawn(&mut self) -> io::Result<Child> {
+        Err(unsupported())
+    }
+
+    pub async fn output(&mut self) -> io::Result<Output> {
+        Err(unsupported())
+    }
+}
+
+impl From<std::process::Command> for Command {
+    fn from(inner: std::process::Command) -> Command {
+        Command { inner }
+    }
+}
+
+/// A running child process. None can be started on AROS yet.
+pub struct Child {
+    pub stdin: Option<ChildStdin>,
+    pub stdout: Option<ChildStdout>,
+    pub stderr: Option<ChildStderr>,
+    never: Never,
+}
+
+impl fmt::Debug for Child {
+    fn fmt(&self, _f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.never {}
+    }
+}
+
+impl Child {
+    pub fn id(&self) -> Option<u32> {
+        match self.never {}
+    }
+
+    pub fn start_kill(&mut self) -> io::Result<()> {
+        match self.never {}
+    }
+
+    pub async fn kill(&mut self) -> io::Result<()> {
+        match self.never {}
+    }
+
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        match self.never {}
+    }
+
+    pub async fn wait(&mut self) -> io::Result<ExitStatus> {
+        match self.never {}
+    }
+
+    pub async fn wait_with_output(self) -> io::Result<Output> {
+        match self.never {}
+    }
+}
+
+macro_rules! pipe_end {
+    ($name:ident) => {
+        pub struct $name(Never);
+
+        impl fmt::Debug for $name {
+            fn fmt(&self, _f: &mut fmt::Formatter<'_>) -> fmt::Result {
+                match self.0 {}
+            }
+        }
+    };
+}
+
+pipe_end!(ChildStdin);
+pipe_end!(ChildStdout);
+pipe_end!(ChildStderr);
+
+impl AsyncWrite for ChildStdin {
+    fn poll_write(self: Pin<&mut Self>, _: &mut Context<'_>, _: &[u8]) -> Poll<io::Result<usize>> {
+        match self.0 {}
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match self.0 {}
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match self.0 {}
+    }
+}
+
+impl AsyncRead for ChildStdout {
+    fn poll_read(self: Pin<&mut Self>, _: &mut Context<'_>, _: &mut ReadBuf<'_>) -> Poll<io::Result<()>> {
+        match self.0 {}
+    }
+}
+
+impl AsyncRead for ChildStderr {
+    fn poll_read(self: Pin<&mut Self>, _: &mut Context<'_>, _: &mut ReadBuf<'_>) -> Poll<io::Result<()>> {
+        match self.0 {}
+    }
+}
