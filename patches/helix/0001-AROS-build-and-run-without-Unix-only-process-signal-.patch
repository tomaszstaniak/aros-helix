index 0000000000000000000000000000000000000000..52ef853f79716aca5f270307d272b69d5bf6cbac
--- /dev/null
+++ b/helix-stdx/src/aros_random.rs
@@ -0,0 +1,23 @@
+//! getrandom 0.3 has no AROS backend. AROS builds select its custom backend
+//! (`--cfg getrandom_backend="custom"`), and this supplies it from libc's
+//! getentropy, which rust-aros backs with jitterentropy. tempfile uses it to
+//! choose names. Exported exactly once per program, from here.
+
+/// # Safety
+/// Called only by getrandom, with a writable buffer of `len` bytes.
+#[no_mangle]
+unsafe fn __getrandom_v03_custom(dest: *mut u8, len: usize) -> Result<(), getrandom::Error> {
+    // getentropy takes at most 256 bytes at a time. The buffer may be
+    // uninitialized, so it is only ever written through the raw pointer.
+    let mut offset = 0;
+    while offset < len {
+        let chunk_len = (len - offset).min(256);
+        let chunk = unsafe { dest.add(offset) };
+        if unsafe { libc::getentropy(chunk.cast(), chunk_len) } != 0 {
+            unsafe { core::ptr::write_bytes(dest, 0, len) };
+            return Err(getrandom::Error::new_custom(1));
+        }
+        offset += chunk_len;
+    }
+    Ok(())
+}
