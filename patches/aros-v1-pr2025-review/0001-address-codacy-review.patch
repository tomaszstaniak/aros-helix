Subject: [PATCH] tests: restore CRT helper includes and narrow temporary scopes

Base-Commit: f7ad104f8fcd379218ec322308d7dbf464b2ae25
Related-PR: https://github.com/aros-development-team/AROS/pull/2025

diff --git a/developer/debug/test/crt/posixc/mmakefile.src b/developer/debug/test/crt/posixc/mmakefile.src
--- a/developer/debug/test/crt/posixc/mmakefile.src
+++ b/developer/debug/test/crt/posixc/mmakefile.src
@@ -165,6 +165,7 @@
 #MM : includes linklibs
 #MM test-crt-posixc-close-pipe-progress : includes linklibs
 
+USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/..
 USER_CPPFLAGS := -D_GNU_SOURCE
 %build_prog mmake=test-crt-posixc-vfork-fd-thread \
     progname=vfork_fd_thread files=vfork_fd_thread targetdir=$(EXEDIR) uselibs="pthread"
diff --git a/developer/debug/test/crt/posixc/test_atomic_dup.py b/developer/debug/test/crt/posixc/test_atomic_dup.py
--- a/developer/debug/test/crt/posixc/test_atomic_dup.py
+++ b/developer/debug/test/crt/posixc/test_atomic_dup.py
@@ -1,5 +1,7 @@
 #!/usr/bin/env python3
-"""Compile the actual duplicate helper against a deterministic table harness.
+"""
+Compile the actual duplicate helper against a deterministic table harness.
+
 A competing global owner takes the selected slot immediately before reserve;
 lookup/publication mocks also require the spanning table guard.
 """
diff --git a/developer/debug/test/crt/posixc/vfork_context.c b/developer/debug/test/crt/posixc/vfork_context.c
--- a/developer/debug/test/crt/posixc/vfork_context.c
+++ b/developer/debug/test/crt/posixc/vfork_context.c
@@ -66,7 +66,6 @@
             int status = -1;
             int saved_errno;
             volatile unsigned int polls = 0;
-            long long now;
             volatile long long deadline = milliseconds();
 
             TEST(deadline >= 0);
@@ -88,6 +87,8 @@
 
             do
             {
+                long long now;
+
                 errno = 0;
                 waited = waitpid(child, &status, WNOHANG);
                 saved_errno = errno;
