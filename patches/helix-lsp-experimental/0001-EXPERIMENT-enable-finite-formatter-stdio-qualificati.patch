+async fn drain<R: AsyncRead + Unpin>(reader: Option<R>) -> io::Result<Vec<u8>> {
+    let Some(mut reader) = reader else { return Ok(Vec::new()); };
+    let mut data = Vec::new();
+    let mut overflow = false;
+    let mut buf = [0; 8192];
+    loop {
+        let n = reader.read(&mut buf).await?;
+        if n == 0 { break; }
+        if data.len() <= OUTPUT_LIMIT.saturating_sub(n) && !overflow { data.extend_from_slice(&buf[..n]); }
+        else { overflow = true; }
+        // Keep draining after the limit: otherwise a finite producer blocks
+        // forever on its full stdout while we wait for its exit.
+    }
+    if overflow { Err(io::Error::new(io::ErrorKind::InvalidData, "child output exceeded 8 MiB per stream")) }
+    else { Ok(data) }
+}
 
