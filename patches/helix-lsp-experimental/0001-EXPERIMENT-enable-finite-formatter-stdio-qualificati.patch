-//! Async child processes on AROS.
+//! Async child I/O without a mio process backend.
 //!
-//! Tokio's `process` module needs mio, which has no AROS backend. This module
-//! offers the part of its API that Helix uses, so language servers, debug
-//! adapters, formatters, `:sh`, `:pipe` and URL openers compile unchanged;
-//! starting a program reports `Unsupported` until a thread-backed
-//! implementation replaces it. A child can therefore never exist, and the
-//! types that would belong to one are uninhabited.
-use std::{
-    ffi::OsStr,
-    fmt, io,
-    path::Path,
-    pin::Pin,
-    process::{ExitStatus, Output, Stdio},
-    task::{Context, Poll},
-};
+//! File I/O uses Tokio's bounded blocking workers. Both output streams are
+//! drained concurrently; child status polling never holds a lock across wait.
+//! AROS still needs a real process termination contract before kill-on-drop
+//! can be offered. In particular a DOS break signal is not POSIX SIGKILL.
+use std::{ffi::OsStr, fmt, io, path::Path, pin::Pin,
+    process::{ExitStatus, Output, Stdio}, task::{Context, Poll}};
+use tokio::{fs::File, io::{AsyncRead, AsyncReadExt, AsyncWrite, ReadBuf}};
 
-use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
