+impl Drop for Child {
+    fn drop(&mut self) {
+        let Some(mut inner) = self.inner.take() else { return; };
+        if inner.try_wait().ok().flatten().is_some() { return; }
+        if self.kill_on_drop { let _ = inner.kill(); }
+        // A dropped std Child does not reap. Keep it owned until wait returns,
+        // without blocking the UI. AROS persistent children are refused above;
+        // this path cannot turn ENOSYS into a successful termination.
+        if let Ok(handle) = tokio::runtime::Handle::try_current() {
+            handle.spawn_blocking(move || { let _ = inner.wait(); });
+        } else {
+            std::thread::spawn(move || { let _ = inner.wait(); });
         }
-    };
+    }
