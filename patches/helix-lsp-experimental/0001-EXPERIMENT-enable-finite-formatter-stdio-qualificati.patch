+fn pipe_file<P: Into<std::os::fd::OwnedFd>>(pipe: P) -> File {
+    let mut file = File::from_std(std::fs::File::from(pipe.into()));
+    // The selected AROS DOS pipe waits to satisfy the requested read length.
+    // Match rust-aros transport's explicit DosPipe policy; do not prefetch an
+    // 8 KiB header while an LSP peer is waiting for a response.
+    if cfg!(target_os = "aros") { file.set_max_buf_size(1); }
+    file
 }
 
