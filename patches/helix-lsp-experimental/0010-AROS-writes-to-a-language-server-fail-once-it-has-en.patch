-pub struct ChildStdin(Option<File>);
-pub struct ChildStdout(File);
+/// The child's stdin. Writes fail with `BrokenPipe` once its stdout has
+/// reached end of file: on AROS a write to a pipe whose reader has ended
+/// does not fail but waits for ever, and Tokio would wait for that write
+/// when the program ends. A child that closes stdout but still reads stdin
+/// is not served; language servers do not do that.
+pub struct ChildStdin(Option<File>, Arc<AtomicBool>);
+/// The child's stdout; its end of file marks the child as ended for stdin.
+pub struct ChildStdout(File, Arc<AtomicBool>);
 pub struct ChildStderr(File);
 macro_rules! debug_pipe { ($t:ident) => {
     impl fmt::Debug for $t {
@@ -173,12 +181,18 @@ fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.write_str(stringify
