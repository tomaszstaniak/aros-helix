+                        // A server still in the registry was not stopped by
+                        // Helix (:lsp-stop, :lsp-restart and quitting remove
+                        // it first): it ended by itself, so say so plainly.
+                        match self.editor.language_server_by_id(server_id) {
+                            Some(server) if server.is_initialized() => self.editor.set_error(format!(
